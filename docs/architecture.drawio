ze=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="c34"><mxGeometry as="geometry" x="20" y="142" width="280" height="64" /></mxCell><mxCell id="c37" value="&lt;b&gt;Score explicable · score.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;100·σ(b0 + Σ wᵢxᵢ) + bonus « nouveau schéma »&lt;br&gt;points par signal : somme = score − base&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="c34"><mxGeometry as="geometry" x="20" y="220" width="280" height="64" /></mxCell><mxCell id="c38" value="&lt;b&gt;Enjeu complété · enjeux.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;douane sous-évaluée · imports excédentaires&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="c34"><mxGeometry as="geometry" x="20" y="298" width="280" height="48" /></mxCell><mxCell id="c39" value="&lt;b&gt;Priorité = score × enjeu&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;PRIORITAIRE · SURVEILLANCE · NORMAL · CONFIANCE&lt;br&gt;action suggérée · résumé en français&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#111827;align=center;verticalAlign=middle;spacing=4;" vertex="1" parent="c34"><mxGeometry as="geometry" x="20" y="360" width="280" height="64" /></mxCell><mxCell id="c40" value="&lt;b&gt;Évaluation · evaluate.py&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10px&quot;&gt;top 50 / mois : Basira vs règle SAR vs hasard&lt;br&gt;validation croisée · modèle hors période de test&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;fontColor=#111827;align=center;verticalAlign=mi