ence · changement&lt;br&gt;pairs · réseau&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontColor=#111827;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="330" y="160" width="210" height="110" /></mxCell><mxCell id="c6" value="&lt;b style=&quot;font-size:15px&quot;&gt;Score IA&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;régression logistique&lt;br&gt;score explicable × enjeu&lt;br&gt;→ priorité des contrôles&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontColor=#111827;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="580" y="160" width="210" height="110" /></mxCell><mxCell id="c7" value="&lt;b style=&quot;font-size:15px&quot;&gt;API&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;FastAPI&lt;br&gt;scores · preuves · réseau&lt;br&gt;assistant + garde-fou&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontColor=#111827;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="880" y="160" width="210" height="110" /></mxCell><mxCell id="c8" value="&lt;b style=&quot;font-size:15px&quot;&gt;Interface web&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;portefeuille · fiche&lt;br&gt;graphe du réseau · copilote&lt;br&gt;décision&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontColor=#111827;spacing=8;" vertex="1" parent="1"><mxGeometry as="geometry" x="1180" y="160" width="210" height="110" /></mxCell><mxCell id="c9" value="&lt;b style=&quot;font-size:15px&quot;&gt;LLM local&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px;color:#374151&quot;&gt;Qwen 3.5 9B&lt;br&gt;aucune donnée ne sort&lt;/span&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#f